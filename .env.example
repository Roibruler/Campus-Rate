PORT=3000
MONGO_URI=
NODE_ENV=development
CORS_ORIGINS=http://localhost:3000

# Option bonus T2/T3/T4 : HTTPS local (facultatif, désactivé par défaut).
# Mettre HTTPS_ENABLED=true et générer un certificat autosigné (voir README)
# pour faire tourner l'API en HTTPS et activer la redirection HTTP -> HTTPS.
HTTPS_ENABLED=false
SSL_KEY_PATH=./certs/localhost-key.pem
SSL_CERT_PATH=./certs/localhost-cert.pem
HTTP_REDIRECT_PORT=3001

# Option bonus A1 : authentification JWT (facultative).
JWT_SECRET=
JWT_EXPIRES_IN=1h
