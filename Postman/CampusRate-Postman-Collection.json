    {
      "name": "10. Persistance après redémarrage",
      "item": [
        {
          "name": "Créer une location témoin (avant redémarrage)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Statut 201 Created\", function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "",
                  "const jsonData = pm.response.json();",
                  "pm.collectionVariables.set(\"persistenceLocationId\", jsonData.id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Local témoin - test de persistance\",\n  \"description\": \"Créé pour vérifier que les données survivent à un redémarrage du serveur.\",\n  \"category\": \"OTHER\",\n  \"address\": \"N/A\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/locations",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "locations"
              ]
            },
            "description": "IMPORTANT : après avoir exécuté cette requête, arrête le serveur (Ctrl+C dans le terminal) puis relance-le (npm run start:dev) AVANT d'exécuter la requête suivante de ce dossier."
          },
          "response": []
        },
        {
          "name": "Vérifier que la location existe toujours après redémarrage",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"La location créée avant redémarrage existe toujours\", function () {\n    pm.response.to.have.status(200);\n    const jsonData = pm.response.json();\n    pm.expect(jsonData.id).to.equal(pm.collectionVariables.get(\"persistenceLocationId\"));\n});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/locations/{{persistenceLocationId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "locations",
                "{{persistenceLocationId}}"
              ]
            },
            "description": "Confirme que les données sont bien persistées dans MongoDB entre deux redémarrages du serveur (arrêter le serveur, le redémarrer, puis refaire un GET sur la même location)."
          },
          "response": []
        }
      ]
    }
