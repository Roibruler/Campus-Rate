    {
      "name": "5. Filtrer et paginer la collection",
      "item": [
        {
          "name": "Lister les endroits filtrés et paginés",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Statut 200 OK\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test(\"La réponse a la forme { data, pagination }\", function () {",
                  "    const jsonData = pm.response.json();",
                  "    pm.expect(jsonData).to.have.property(\"data\");",
                  "    pm.expect(jsonData).to.have.property(\"pagination\");",
                  "    pm.expect(jsonData.pagination).to.have.property(\"page\");",
                  "    pm.expect(jsonData.pagination).to.have.property(\"limit\");",
                  "    pm.expect(jsonData.pagination).to.have.property(\"totalItems\");",
                  "    pm.expect(jsonData.pagination).to.have.property(\"totalPages\");",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/locations?category=STUDY_SPACE&page=1&limit=5",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "locations"
              ],
              "query": [
                {
                  "key": "category",
                  "value": "STUDY_SPACE"
                },
                {
                  "key": "page",
                  "value": "1"
                },
                {
                  "key": "limit",
                  "value": "5"
                }
              ]
            },
            "description": "Vérifie : filtre par catégorie et pagination combinés, format de réponse { data, pagination }."
          },
          "response": []
        }
      ]
    },
    {
      "name": "6. Note invalide",
      "item": [
        {
          "name": "Créer une appréciation avec une note hors bornes (10)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Statut 400 Bad Request\", function () {",
                  "    pm.response.to.have.status(400);",
                  "});",
                  "",
                  "pm.test(\"Réponse au format Problem Details\", function () {",
                  "    pm.expect(pm.response.headers.get(\"Content-Type\")).to.include(\"application/problem+json\");",
                  "    const jsonData = pm.response.json();",
                  "    pm.expect(jsonData).to.have.property(\"type\");",
                  "    pm.expect(jsonData).to.have.property(\"title\");",
                  "    pm.expect(jsonData.status).to.equal(400);",
                  "    pm.expect(jsonData).to.have.property(\"detail\");",
                  "    pm.expect(jsonData).to.have.property(\"instance\");",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"placeId\": \"{{locationId}}\",\n  \"authorName\": \"Test\",\n  \"rating\": 10,\n  \"comment\": \"Note invalide\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/appreciations",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "appreciations"
              ]
            },
            "description": "Vérifie : validation métier (rating doit être entre 1 et 5), code 400 au format Problem Details."
          },
          "response": []
        }
      ]
    },
