    {
      "name": "8. Conflit de suppression",
      "item": [
        {
          "name": "Tenter de supprimer un endroit qui a encore une appréciation",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Statut 409 Conflict\", function () {",
                  "    pm.response.to.have.status(409);",
                  "});",
                  "",
                  "pm.test(\"Réponse au format Problem Details\", function () {",
                  "    pm.expect(pm.response.headers.get(\"Content-Type\")).to.include(\"application/problem+json\");",
                  "    const jsonData = pm.response.json();",
                  "    pm.expect(jsonData.status).to.equal(409);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/locations/{{locationId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "locations",
                "{{locationId}}"
              ]
            },
            "description": "Vérifie : refus de suppression d'un endroit qui a encore des appréciations, code 409 au format Problem Details. (L'appréciation créée au scénario 2 existe encore à ce stade.)"
          },
          "response": []
        }
      ]
    },
