          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"averageRating et reviewCount reflètent l'appréciation créée\", function () {",
                  "    const jsonData = pm.response.json();",
                  "    pm.expect(jsonData.reviewCount).to.equal(1);",
                  "    pm.expect(jsonData.averageRating).to.equal(4);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/locations/{{locationId}}",
