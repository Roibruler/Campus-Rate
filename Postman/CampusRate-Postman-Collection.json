          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Bibliothèque principale\",\n  \"description\": \"Espace calme avec prises.\",\n  \"category\": \"STUDY_SPACE\",\n  \"address\": \"Pavillon A, local A-210\",\n  \"services\": [\"WIFI\", \"POWER_OUTLETS\"],\n  \"status\": \"ACTIVE\",\n  \"averageRating\": 4.5\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/locations",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "locations"
              ]
            },
            "description": "Vérifie : création d'un endroit avec une propriété gérée par le serveur (averageRating) envoyée par le client, code 400 au format Problem Details."
          },
          "response": []
        },
        {
          "name": "Consulter l'endroit créé",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Statut 200 OK\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "const jsonData = pm.response.json();",
                  "pm.test(\"L'id retourné correspond à celui créé\", function () {",
                  "    pm.expect(jsonData.id).to.equal(pm.collectionVariables.get(\"locationId\"));",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/locations/{{locationId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "locations",
                "{{locationId}}"
              ]
            },
            "description": "Vérifie : consultation d'un endroit par son id, code 200."
          },
          "response": []
        }
      ]
