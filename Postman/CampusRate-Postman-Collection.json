        {
          "name": "1c. Créer un endroit - propriété interdite (400)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Statut 400 Bad Request\", function () {\n    pm.response.to.have.status(400);\n});\n\nconst jsonData = pm.response.json();\npm.test(\"Le message d'erreur mentionne la propriété interdite\", function () {\n    pm.expect(jsonData.detail).to.include(\"averageRating\");\n});"
                ]
