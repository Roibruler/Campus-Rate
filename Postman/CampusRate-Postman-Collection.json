                "{{baseUrl}}"
              ],
              "path": [
                "locations",
                "{{locationId}}"
              ]
            },
            "description": "Vérifie : averageRating et reviewCount sont recalculés automatiquement après la création d'une appréciation."
          },
          "response": []
        }
      ]
